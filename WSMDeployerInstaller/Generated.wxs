      </Component>
      <Component Id="Cmp_Avalonia_Win32_Automation_21" Guid="a3b33c90-4683-43e6-860f-3853a18c1ea4">
        <File Source="$(var.DeployerDir)\Avalonia.Win32.Automation.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Win32_22" Guid="84bca1a9-8744-40b1-8876-4569298e19ab">
