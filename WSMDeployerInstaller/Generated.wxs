      </Component>
      <Component Id="Cmp_Avalonia_X11_23" Guid="24c3365a-a9ca-4454-a849-c34464cd8793">
        <File Source="$(var.DeployerDir)\Avalonia.X11.dll" />
      </Component>
      <Component Id="Cmp_av_libglesv2_24" Guid="63f7f8f1-180e-4cec-923b-f2b3f144a038">
