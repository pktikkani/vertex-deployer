      </Component>
      <Component Id="Cmp_System_IO_Pipelines_38" Guid="cb217f79-2599-4a83-8cc5-7090305262bf">
        <File Source="$(var.DeployerDir)\System.IO.Pipelines.dll" />
      </Component>
      <Component Id="Cmp_System_Management_39" Guid="383d888e-1021-4c67-b96e-42b1e6d15b7b">
        <File Source="$(var.DeployerDir)\System.Management.dll" />
      </Component>
      <Component Id="Cmp_System_Security_Cryptography_ProtectedData_40" Guid="728106bf-4d03-4a1f-b5e4-2c3ec43b5fbf">
        <File Source="$(var.DeployerDir)\System.Security.Cryptography.ProtectedData.dll" />
      </Component>
      <Component Id="Cmp_Tmds_DBus_Protocol_41" Guid="d0bf0a7a-97b5-4710-ab5a-9bfdc6bebc4c">
