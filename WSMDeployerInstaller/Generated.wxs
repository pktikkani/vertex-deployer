      </Component>
      <Component Id="Cmp_Avalonia_Desktop_6" Guid="69d62942-82c5-437d-a7d9-c157e0a54a17">
        <File Source="$(var.DeployerDir)\Avalonia.Desktop.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Dialogs_7" Guid="9a6d6ad6-0535-42f1-b640-c55d0b3a7016">
