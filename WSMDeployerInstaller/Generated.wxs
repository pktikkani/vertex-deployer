      </Component>
      <Component Id="Cmp_Avalonia_OpenGL_16" Guid="eaa96b43-5747-4472-8926-274212a03294">
        <File Source="$(var.DeployerDir)\Avalonia.OpenGL.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Remote_Protocol_17" Guid="e1c37edf-0154-4516-a5ea-b9ed8d5ce7fd">
        <File Source="$(var.DeployerDir)\Avalonia.Remote.Protocol.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Skia_18" Guid="958e7cdf-27a5-4ef9-8626-b68063ced43b">
        <File Source="$(var.DeployerDir)\Avalonia.Skia.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Themes_Fluent_19" Guid="70b540ab-b908-4bc2-86e1-c0f4c683f46e">
        <File Source="$(var.DeployerDir)\Avalonia.Themes.Fluent.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Vulkan_20" Guid="2bbcad8f-2540-465b-a499-3115a2887e68">
