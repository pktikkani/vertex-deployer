      </Component>
      <Component Id="Cmp_Avalonia_Win32_Automation_21" Guid="bfa47640-50a7-4ed9-b9b5-c8110e9572ec">
        <File Source="$(var.DeployerDir)\Avalonia.Win32.Automation.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Win32_22" Guid="12df012a-3383-4e34-b9c3-503bcb9c6cf7">
