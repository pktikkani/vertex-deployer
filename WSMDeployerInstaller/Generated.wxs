        <File Source="$(var.DeployerDir)\Avalonia.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Fonts_Inter_9" Guid="34051131-28a6-42bd-bace-348ee48f9588">
        <File Source="$(var.DeployerDir)\Avalonia.Fonts.Inter.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_FreeDesktop_10" Guid="4b91362c-14d6-4192-bed5-5edbefa7374f">
