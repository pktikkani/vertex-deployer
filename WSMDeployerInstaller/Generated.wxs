        <File Source="$(var.DeployerDir)\Avalonia.Native.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_OpenGL_16" Guid="8c3a880a-ea28-42ed-bb5a-6a26d8dce09c">
        <File Source="$(var.DeployerDir)\Avalonia.OpenGL.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Remote_Protocol_17" Guid="970d3fc7-b856-4be4-b96e-ba5329b87e9a">
        <File Source="$(var.DeployerDir)\Avalonia.Remote.Protocol.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Skia_18" Guid="1b49f572-77fb-453f-8007-2cf479903c7e">
        <File Source="$(var.DeployerDir)\Avalonia.Skia.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Themes_Fluent_19" Guid="dc79ede1-5091-4341-b38e-1b0b3d9cfbe1">
        <File Source="$(var.DeployerDir)\Avalonia.Themes.Fluent.dll" />
      </Component>
      <Component Id="Cmp_Avalonia_Vulkan_20" Guid="64879766-16ab-4983-b8be-ab83636bad98">
