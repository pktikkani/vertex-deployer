      </Component>
      <Component Id="Cmp_SQLitePCLRaw_core_35" Guid="18e2b0d0-8c0d-4e33-9c89-44d32fc5a0c7">
        <File Source="$(var.DeployerDir)\SQLitePCLRaw.core.dll" />
      </Component>
      <Component Id="Cmp_SQLitePCLRaw_provider_e_sqlite3_36" Guid="96da522b-d222-447b-9e10-275cee3ebed4">
        <File Source="$(var.DeployerDir)\SQLitePCLRaw.provider.e_sqlite3.dll" />
      </Component>
      <Component Id="Cmp_System_CodeDom_37" Guid="cc7489b1-402f-41b0-8ae4-1b5cdbc5f7df">
