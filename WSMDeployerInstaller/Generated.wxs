      </Component>
      <Component Id="Cmp_e_sqlite3_25" Guid="557f4a9b-a801-4486-99e0-982ac0b5bc56">
        <File Source="$(var.DeployerDir)\e_sqlite3.dll" />
      </Component>
      <Component Id="Cmp_FluentAvalonia_26" Guid="d2ba72d1-2a47-432b-8a5a-3667789f06ef">
        <File Source="$(var.DeployerDir)\FluentAvalonia.dll" />
      </Component>
      <Component Id="Cmp_HarfBuzzSharp_27" Guid="6f0d385d-73fc-4d5b-a21d-2e1e8d4d91a5">
        <File Source="$(var.DeployerDir)\HarfBuzzSharp.dll" />
      </Component>
      <Component Id="Cmp_libHarfBuzzSharp_28" Guid="643a5259-8776-47b7-ae19-1fa4bf93dd12">
        <File Source="$(var.DeployerDir)\libHarfBuzzSharp.dll" />
      </Component>
      <Component Id="Cmp_libSkiaSharp_29" Guid="098bba0e-7df2-419a-931f-50725829969e">
        <File Source="$(var.DeployerDir)\libSkiaSharp.dll" />
      </Component>
      <Component Id="Cmp_MicroCom_Runtime_30" Guid="159ba45d-3f82-4b4b-a38a-ea017cb52bd0">
        <File Source="$(var.DeployerDir)\MicroCom.Runtime.dll" />
      </Component>
      <Component Id="Cmp_Microsoft_Data_Sqlite_31" Guid="1779d969-a76d-4c91-abcf-154358c8661e">
        <File Source="$(var.DeployerDir)\Microsoft.Data.Sqlite.dll" />
      </Component>
      <Component Id="Cmp_Newtonsoft_Json_32" Guid="b0fb2f81-ab68-44ea-8283-b193260f8d82">
        <File Source="$(var.DeployerDir)\Newtonsoft.Json.dll" />
      </Component>
      <Component Id="Cmp_SkiaSharp_33" Guid="5957fd45-eca3-464b-aa59-8641f4be29db">
        <File Source="$(var.DeployerDir)\SkiaSharp.dll" />
      </Component>
      <Component Id="Cmp_SQLitePCLRaw_batteries_v2_34" Guid="5ffcd3b6-6d8d-4efb-b80b-6bd43ab37713">
