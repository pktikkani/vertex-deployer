      </Component>
      <Component Id="Cmp_FluentAvalonia_26" Guid="b1b5ccaa-08c0-4961-9618-45b1dd5925c7">
        <File Source="$(var.DeployerDir)\FluentAvalonia.dll" />
      </Component>
      <Component Id="Cmp_HarfBuzzSharp_27" Guid="cbc85f08-566e-4829-a169-9d55e0e20dc1">
        <File Source="$(var.DeployerDir)\HarfBuzzSharp.dll" />
      </Component>
      <Component Id="Cmp_libHarfBuzzSharp_28" Guid="4a2fa3ff-e9dc-441b-ad86-8eac8b47e1ce">
        <File Source="$(var.DeployerDir)\libHarfBuzzSharp.dll" />
      </Component>
      <Component Id="Cmp_libSkiaSharp_29" Guid="98297a4d-0d5b-4053-8c1b-13d35c5d1c5a">
        <File Source="$(var.DeployerDir)\libSkiaSharp.dll" />
      </Component>
      <Component Id="Cmp_MicroCom_Runtime_30" Guid="26275cbd-1454-4034-9043-08176dd1a5a9">
        <File Source="$(var.DeployerDir)\MicroCom.Runtime.dll" />
      </Component>
      <Component Id="Cmp_Microsoft_Data_Sqlite_31" Guid="f987c359-b8f9-46b7-84a5-1954bd3af4bc">
        <File Source="$(var.DeployerDir)\Microsoft.Data.Sqlite.dll" />
      </Component>
      <Component Id="Cmp_Newtonsoft_Json_32" Guid="c2227d47-a48c-468e-b0f7-82b69d20af14">
        <File Source="$(var.DeployerDir)\Newtonsoft.Json.dll" />
      </Component>
      <Component Id="Cmp_SkiaSharp_33" Guid="35e39921-8846-4d65-aa46-b24cf55512bb">
