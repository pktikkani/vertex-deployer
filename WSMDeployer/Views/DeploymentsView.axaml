<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WSMDeployer.ViewModels"
             xmlns:models="using:WSMDeployer.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="WSMDeployer.Views.DeploymentsView"
             x:DataType="vm:DeploymentsViewModel">

    <StackPanel Spacing="30">
        <!-- Page Header -->
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="10">
                <TextBlock Text="Deployments" Classes="heading1"/>
                <TextBlock Text="Monitor and manage Vertex deployments" Classes="body"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🔄" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Statistics Cards -->
        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto">
            <Border Grid.Column="0" Classes="metric-card" Margin="0,0,10,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Total" Classes="caption" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalDeployments}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="metric-card" Margin="10,0,10,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Success" Classes="caption" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SuccessfulDeployments}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="metric-card" Margin="10,0,10,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Failed" Classes="caption" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding FailedDeployments}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Classes="metric-card" Margin="10,0,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="In Progress" Classes="caption" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding InProgressDeployments}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Deployments Table -->
        <Border Classes="card">
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="📋" FontSize="20"/>
                    <TextBlock Text="Deployment History" Classes="heading3" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator/>

                <DataGrid ItemsSource="{Binding Deployments}"
                          SelectedItem="{Binding SelectedDeployment}"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          MaxHeight="500">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Target"
                                          Binding="{Binding Target.Hostname}"
                                          Width="180"/>

                        <DataGridTextColumn Header="Method"
                                          Binding="{Binding Method}"
                                          Width="150"/>

                        <DataGridTextColumn Header="Status"
                                          Binding="{Binding StatusDisplay}"
                                          Width="130"/>

                        <DataGridTextColumn Header="Started"
                                          Binding="{Binding StartTime, StringFormat='{}{0:MM/dd HH:mm}'}"
                                          Width="120"/>

                        <DataGridTextColumn Header="Completed"
                                          Binding="{Binding EndTime, StringFormat='{}{0:MM/dd HH:mm}'}"
                                          Width="120"/>

                        <DataGridTextColumn Header="Duration"
                                          Binding="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}"
                                          Width="90"/>

                        <DataGridTextColumn Header="Error"
                                          Binding="{Binding ErrorMessage}"
                                          Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <Border IsVisible="{Binding !Deployments.Count}" Padding="40">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="No deployments yet" Classes="heading3" HorizontalAlignment="Center"/>
                        <TextBlock Text="Start deploying Vertex to see history here" Classes="body" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Selected Deployment Details -->
        <Border Classes="card" IsVisible="{Binding SelectedDeployment, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="15">
                <TextBlock Text="Deployment Details" Classes="heading3"/>
                <Separator/>

                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target:" Classes="body" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDeployment.Target.Hostname}" Classes="body" Margin="0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Method:" Classes="body" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDeployment.Method}" Classes="body" Margin="0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" Classes="body" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDeployment.StatusDisplay}" Classes="body" Margin="0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Started:" Classes="body" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDeployment.StartTime, StringFormat='{}{0:MM/dd/yyyy HH:mm:ss}'}" Classes="body" Margin="0,5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Completed:" Classes="body" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDeployment.EndTime, StringFormat='{}{0:MM/dd/yyyy HH:mm:ss}'}" Classes="body" Margin="0,5"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Duration:" Classes="body" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDeployment.Duration, StringFormat='{}{0:mm\\:ss}'}" Classes="body" Margin="0,5"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Error Message:" Classes="body" FontWeight="SemiBold" Margin="0,5"
                               IsVisible="{Binding SelectedDeployment.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedDeployment.ErrorMessage}"
                               Classes="body" Foreground="{DynamicResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="0,5"
                               IsVisible="{Binding SelectedDeployment.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>

                <Button Classes="primary" Command="{Binding ViewLogsCommand}" Margin="0,10,0,0" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📄" />
                        <TextBlock Text="View Full Logs" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
