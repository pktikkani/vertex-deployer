<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WSMDeployer.ViewModels"
             xmlns:models="using:WSMDeployer.Models"
             x:Class="WSMDeployer.Views.LogsPage"
             x:DataType="vm:LogsPageViewModel">

    <ScrollViewer>
        <StackPanel Margin="30" Spacing="20">
            <!-- Header -->
            <TextBlock Text="📋 Deployment Logs"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <!-- Statistics -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="15">
                <Border Classes="card">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Total" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding TotalDeployments}" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Classes="card" Grid.Column="1" Background="#1B5E20">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Successful" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding SuccessfulDeployments}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Classes="card" Grid.Column="2" Background="#C62828">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Failed" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding FailedDeployments}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Classes="card" Grid.Column="3" Background="#EF6C00">
                    <StackPanel Spacing="5">
                        <TextBlock Text="In Progress" FontSize="12" Foreground="White"/>
                        <TextBlock Text="{Binding InProgressDeployments}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Filters -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding SearchText}"
                         Watermark="🔍 Search..."
                         Classes="modern"/>

                <Button Grid.Column="1" Classes="secondary" Command="{Binding RefreshCommand}">
                    <TextBlock Text="🔄 Refresh"/>
                </Button>

                <Button Grid.Column="2" Classes="danger" Command="{Binding ClearLogsCommand}">
                    <TextBlock Text="🗑️ Clear"/>
                </Button>

                <Button Grid.Column="3" Classes="accent" Command="{Binding ExportLogsCommand}">
                    <TextBlock Text="💾 Export"/>
                </Button>
            </Grid>

            <!-- Deployment List -->
            <Border Classes="card">
                <StackPanel Spacing="15">
                    <TextBlock Text="Recent Deployments" Classes="heading3" FontSize="16"/>

                    <ItemsControl ItemsSource="{Binding Deployments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:Deployment">
                                <Border Classes="card" Margin="0,0,0,10" Padding="15">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding TargetHostname}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Method}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding StartTime, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   FontSize="11"
                                                   Foreground="#EF5350"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                        <Border Background="{DynamicResource AppBackground2}"
                                                Padding="10"
                                                CornerRadius="4"
                                                IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding Output}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <StackPanel Spacing="10"
                                IsVisible="{Binding !TotalDeployments}"
                                HorizontalAlignment="Center"
                                Margin="0,40">
                        <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="No deployment logs yet"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
