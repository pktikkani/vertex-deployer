<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme - Claude.ai Style -->

    <!-- Background Colors -->
    <SolidColorBrush x:Key="AppBackground" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="AppBackground2" Color="#171717"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="CardBackground" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#333333"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="TextMuted" Color="#808080"/>

    <!-- Claude Orange Buttons -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#CC5500"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#1F1F1F" Offset="0" />
        <GradientStop Color="#171717" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#CC5500" Offset="0"/>
        <GradientStop Color="#E06010" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
